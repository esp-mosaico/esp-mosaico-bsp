# Optional overrides when CONFIG_CAMERA_PHOTO_USB_MSC=y in menuconfig.
# Merge into sdkconfig.defaults or set via idf.py menuconfig.

CONFIG_CAMERA_PHOTO_USB_MSC=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set


CONFIG_TINYUSB_MSC_ENABLED=y
# CONFIG_TINYUSB_CDC_ENABLED is not set
CONFIG_TINYUSB_MSC_BUFSIZE=4096
