menu "ESP-Mosaico BSP"

    config BSP_CO5300_ENABLE_TE
        bool "Enable CO5300 TE anti-tearing synchronization"
        default y
        help
            Enable the CO5300 tearing-effect output and connect GPIO43 to the
            esp_lvgl_adapter TE synchronization path. The BSP default display
            configuration uses TE_SYNC when this option is enabled.

            Disable this option to omit the CO5300 TE-enable command and use
            the normal SPI display path without a TE interrupt.

    config BSP_LCD_QSPI_DRIVE_CAP
        int "QSPI LCD bus pin drive strength (0-3)"
        range 0 3
        default 0
        help
            GPIO drive capability for the CO5300 QSPI bus pins: SCL and DATA0-DATA3.
            Lower values reduce edge rate and RF emissions (useful for Wi-Fi/BLE
            coexistence). 0 = weakest (GPIO_DRIVE_CAP_0), 3 = strongest.
            Default is 0. Increase if display signal integrity fails at high clock.

    config BSP_NAND_USE_QIO
        bool "Use QIO mode for SPI NAND"
        default n

    config BSP_MOTOR_ENABLE_PWM
        bool "Enable LEDC PWM motor control"
        default y

    config BSP_VCC_3V3_RAMP_MS
        int "VCC_3V3 soft-start ramp time (ms)"
        range 0 1000
        default 50
        help
            Sweep the duty cycle on the VCC_3V3 enable GPIO over this time so the
            high-side switch opens gradually. Set to 0 to drive the pin directly.

endmenu
